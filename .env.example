# Diese Datei nach .env kopieren und mit echten Werten fuellen:
#   cp .env.example .env

PLATFORM=dev

# Registrierung unter https://developer.spotify.com/dashboard
# Redirect-URI dort exakt so eintragen wie hier:
SPOTIFY_CLIENT_ID=deine_client_id
SPOTIFY_CLIENT_SECRET=dein_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Name des Spotify-Connect-Geraets, auf dem tatsaechlich Ton rauskommen soll.
# Wird auch als Name fuers selbstverwaltete librespot genutzt (siehe unten).
SPOTIFY_DEVICE_NAME=Spotty Radio

# Startet automatisch einen eigenen librespot-Hintergrundprozess, damit die
# App selbst als Spotify-Connect-Ziel erscheint (kein separates Handy/Laptop
# mit offener Spotify-App noetig - siehe README fuer das einmalige Setup).
# Auf "false" setzen, um stattdessen weiterhin ein externes Connect-Geraet
# zu nutzen (z.B. Handy mit offener Spotify-App).
SPOTIFY_CONNECT_ENABLED=true
# Audio-Backend fuer librespot - "pulseaudio" passt meist fuer einen
# normalen Ubuntu-Desktop, auf dem Pi spaeter eher "alsa".
SPOTIFY_CONNECT_BACKEND=pulseaudio

# Nur relevant, sobald PLATFORM=pi gesetzt ist:
ENCODER_CLK_PIN=17
ENCODER_DT_PIN=27
ENCODER_SW_PIN=22

# GPIO-Aus-Knopf (nur relevant wenn PLATFORM=pi) - siehe README fuer die
# noetige einmalige sudoers-Einrichtung, sonst schlaegt das Herunterfahren
# fehl.
SHUTDOWN_BUTTON_PIN=26
SHUTDOWN_BUTTON_HOLD_SECONDS=3
SHUTDOWN_BUTTON_ENABLED=true
